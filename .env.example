# Frontend API base URL
VITE_API_BASE_URL=
VITE_SHOW_DEV_OTP_PREVIEW=false

# Backend runtime
API_PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
ALLOW_INSECURE_DEV_OTP=false

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_analyzer

# SMTP settings
# Gmail: use an App Password.
# Other providers (Brevo/Mailtrap/SendGrid/etc.): use provider SMTP host/port and password/token.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SERVICE=
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-smtp-password
# Backward compatibility (optional):
# MAIL_APP_PASSWORD=your-gmail-app-password
MAIL_FROM="AI Resume Analyzer <your-email@gmail.com>"

# OpenAI analysis
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
